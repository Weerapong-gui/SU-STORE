# ===== REQUIRED =====
# ต้องยาวอย่างน้อย 32 ตัวอักษร สร้างได้ด้วย: openssl rand -hex 32
COOKIE_SECRET=your-secret-key-at-least-32-characters-long

# ===== ORDER API =====
# URL ของ order-api (ถ้ารันด้วย docker-compose ใช้ค่านี้)
ORDER_API_BASE_URL=http://order-api:10000
ORDER_API_TOKEN=your-order-api-token

# ===== ORDER SETTINGS =====
ORDER_PREFIX=SU
ORDER_ROUND=1
KHANTOKE_TICKET_QUOTA=2000

# ===== OPTIONAL =====
# ถ้าอยากเก็บสลิปใน Vercel Blob (ไม่จำเป็นถ้ารันบน Docker)
BLOB_READ_WRITE_TOKEN=

# Google Sheets webhook (optional)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=
